# 环境变量示例（复制为参考，按需 export；项目不会自动加载 .env）
#
# 本地开发也可以改用 config_local.py（已 gitignore）：
#   API_KEY = "sk-..."
# 环境变量优先于 config_local.py。

# ---- 大模型（OpenAI 兼容接口）----
LLM_API_KEY=sk-your-key
LLM_MODEL_NAME=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com

# ---- 可选：生产存储后端（未配置时自动回退本地实现）----
# REDIS_URL=redis://localhost:6379/0        # 短期记忆 + 对话限流（多实例共享计数）
# DATABASE_URL=postgresql://aligo:aligo@localhost:5432/aligo
# REDIS_TTL_SEC=3600

# ---- 对话接口限流（默认进程内滑动窗口；配置 REDIS_URL 后由 Redis 共享计数）----
# 各桶额度均按「每窗口 N 次」计；CHAT_RATE_WINDOW_SEC 同时作用于全部桶
# CHAT_RATE_LIMIT=30          # 单用户（客户端 + 用户 ID）/窗口
# CHAT_RATE_LIMIT_IP=120      # 单客户端 IP /窗口
# KB_RATE_LIMIT=60            # 知识库写入 / 导出 / 语义检索 + 自检 / 备份恢复 / with_knowledge 导出（单 IP）/窗口
# KB_IMPORT_RATE_LIMIT=1200   # 知识库导入 / 导入预览 + 行程导入（单 IP）/窗口，面板分批导入需要更高额度
# WEATHER_RATE_LIMIT=30       # 天气查询（单 IP）/窗口，保护 Open-Meteo 免费额度
# READ_RATE_LIMIT=600         # 面板数据读接口（会话列表 / 状态 / 导出 / 台账，单 IP）/窗口
# WRITE_RATE_LIMIT=240        # 用户数据写接口（偏好 / 行程 / 会话元数据 / 删除，单 IP）/窗口
# CHAT_RATE_WINDOW_SEC=60     # 窗口长度（秒，全部 7 个桶共享；各桶等效额度 = N×60/窗口）
# RATE_LIMIT_MAX_KEYS=10000   # 进程内限流器每桶键表上限（100..1000000；满时新 key 暂时 429）
# TRUST_PROXY_HEADERS=1       # 反向代理后按 X-Forwarded-For 最后一个地址限流（默认关闭）
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128  # 允许写 XFF 的对端网段（默认仅回环；容器 / 跨主机代理必须显式配置）
# RATE_IPV6_PREFIX_LEN=64     # IPv6 客户端身份聚合前缀（32..64；按接入网络委派粒度可改 56 / 48）

# ---- Web 服务与安全 ----
# ALIGO_ALLOWED_HOSTS=aligo.example.com,*.example.com  # 通过域名访问时的 Host 白名单
#                                       # （默认只接受回环 / IP 字面量 / *.localhost；未列入与畸形 / 重复 Host 一律 400）
# ALIGO_ENABLE_DOCS=1         # 开启 /docs、/redoc、/openapi.json（默认关闭；schema 暴露全部端点）
# ALIGO_TEST_CLIENT=1         # 仅测试用：放行 Host: testserver 并跳过同源标记检查；生产勿设（启动会打印告警）

# ---- 日志 ----
# LOG_FORMAT=json             # 访问日志输出 JSON lines（默认单行文本）

# ---- RAG 检索（v2.0）----
# RAG_EMBEDDING_MODEL=data/models/bge-small-zh-v1.5   # 嵌入模型目录（可指向本地 bge-m3）
# RAG_MIN_SCORE=0.5                                    # 问答相关性阈值（0–1）
# RAG_HYBRID_ENABLED=true                              # 向量 + BM25 混合检索
# RAG_RERANK_MODEL=                                    # cross-encoder 精排模型（留空不加载）
# RAG_BM25_TTL_SEC=60                                  # BM25 索引缓存秒数（写入 / 删除即时失效）
