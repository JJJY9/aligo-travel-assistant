# 环境变量示例（复制为参考，按需 export；项目不会自动加载 .env）
#
# 本地开发也可以改用 config_local.py（已 gitignore）：
#   API_KEY = "sk-..."
# 环境变量优先于 config_local.py。

# ---- 大模型（OpenAI 兼容接口）----
LLM_API_KEY=sk-your-key
LLM_MODEL_NAME=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com

# ---- 可选：生产存储后端（未配置时自动回退本地实现）----
# REDIS_URL=redis://localhost:6379/0
# DATABASE_URL=postgresql://aligo:aligo@localhost:5432/aligo
# REDIS_TTL_SEC=3600

# ---- 对话接口限流（进程内滑动窗口）----
# CHAT_RATE_LIMIT=30          # 单用户（客户端 + 用户 ID）/窗口
# CHAT_RATE_LIMIT_IP=120      # 单客户端 IP /窗口
# CHAT_RATE_WINDOW_SEC=60     # 窗口长度（秒）

# ---- 日志 ----
# LOG_FORMAT=json             # 访问日志输出 JSON lines（默认单行文本）
